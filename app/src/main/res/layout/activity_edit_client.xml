<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_alt">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="10dp" android:background="@color/black">
        <Button android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/button_dark" android:text="‹" android:textColor="@color/white" android:textSize="28sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/screenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nuovo cliente" android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scheda cliente EDIL Milan" android:textColor="#BDB7B3" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="18dp">

            <TextView style="@style/SectionLabel" android:text="DATI CLIENTE" />
            <TextView style="@style/FieldLabel" android:text="Nome *" />
            <EditText android:id="@+id/firstNameInput" style="@style/ClientField" android:hint="Es. Paolo" android:inputType="textCapWords" android:singleLine="true" />
            <TextView style="@style/FieldLabel" android:text="Cognome" />
            <EditText android:id="@+id/lastNameInput" style="@style/ClientField" android:hint="Es. Rossi" android:inputType="textCapWords" android:singleLine="true" />

            <TextView style="@style/SectionLabel" android:text="CONTATTI" />
            <TextView style="@style/FieldLabel" android:text="Telefono" />
            <EditText android:id="@+id/phoneInput" style="@style/ClientField" android:hint="Numero di cellulare" android:inputType="phone" android:singleLine="true" />
            <TextView style="@style/FieldLabel" android:text="Email" />
            <EditText android:id="@+id/emailInput" style="@style/ClientField" android:hint="Indirizzo email" android:inputType="textEmailAddress" android:singleLine="true" />

            <TextView style="@style/SectionLabel" android:text="CANTIERE E APPUNTI" />
            <TextView style="@style/FieldLabel" android:text="Indirizzo del lavoro" />
            <EditText android:id="@+id/addressInput" style="@style/ClientField" android:hint="Via, numero civico, località" android:inputType="textPostalAddress|textCapSentences" />
            <TextView style="@style/FieldLabel" android:text="Note" />
            <EditText android:id="@+id/notesInput" style="@style/ClientField" android:hint="Lavoro richiesto, sopralluogo, preferenze…" android:gravity="top" android:inputType="textMultiLine|textCapSentences" android:minLines="4" />

            <TextView style="@style/SectionLabel" android:text="RUBRICA DEL TELEFONO" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_background" android:orientation="vertical" android:padding="10dp">
                <CheckBox
                    android:id="@+id/saveToContactsCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/orange"
                    android:padding="6dp"
                    android:text="Salva anche nella rubrica Google / telefono"
                    android:textColor="@color/black"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="38dp" android:paddingEnd="8dp" android:paddingBottom="7dp" android:text="La scheda contatto verrà aperta già compilata. Potrai scegliere l’account Google oppure Telefono." android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/deleteButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/button_soft"
                android:text="Elimina cliente"
                android:textAllCaps="false"
                android:textColor="@color/danger"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" android:elevation="8dp" android:padding="12dp">
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_primary"
            android:text="Salva cliente"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
