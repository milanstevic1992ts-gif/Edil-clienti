{
  "schemaVersion": 1,
  "module": "clienti",
  "displayName": "EDIL Clienti",
  "appVersion": "1.2.0",
  "role": "customer-source-of-truth",
  "protocolVersion": "2",
  "offlineFirst": true,
  "packageId": "it.edilmilan.clienti",
  "capabilities": [
    "client-source",
    "relationship-tracking",
    "customer-context",
    "jobsite-context",
    "tools-handoff",
    "message-compose-launch",
    "estimate-create-launch",
    "local-backup",
    "local-bridge",
    "sqlite-event-outbox",
    "event-envelope-v2",
    "idempotent-event-enqueue",
    "retry-backoff",
    "dead-letter"
  ],
  "publishes": [
    "client.temperature.changed",
    "relationship.signal.created"
  ],
  "consumes": [
    "jobsite.tools.report",
    "estimate.crm.linked"
  ],
  "identities": {
    "clientId": "uuid-persistent",
    "jobsiteId": "uuid-persistent",
    "localClientId": "local-only"
  },
  "deepLinks": {
    "publishes": [
      "ge360://attrezzi/open",
      "ge360://messaggi/compose",
      "ge360://estimate/new"
    ],
    "consumes": [
      "ge360://clienti/jobsite-report",
      "ge360://client/{clientId}"
    ]
  },
  "localBridge": {
    "protocolVersion": "2",
    "permission": "com.edilmilan.ge360.permission.INTEGRATION",
    "requiresSameSigningCertificate": true,
    "targets": [
      "com.edilmilanstevic.attrezzi",
      "com.ge360.messaggi",
      "com.edilmilanstevic.preventivi"
    ],
    "fallback": "ge360-deep-link"
  },
  "delivery": {
    "outbox": "sqlite:outbox_events",
    "persistBeforeSend": true,
    "eventEnvelope": "v2",
    "maxAttempts": 8,
    "retry": "exponential-backoff",
    "deadLetter": true
  },
  "bridgeManager": {
    "discoverable": true,
    "discovery": ["PING", "PONG"]
  }
}
